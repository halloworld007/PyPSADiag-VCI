;PROCEDURE
:ECUID=
:ECUVEID=
:ECUNAME=SUSPENSION_ECOTECH
:NAME_LNG=Depressurise
:

x7_suspension_ecotech_depressurise:
    vehicle: X7
    ecuname: SUSPENSION_ECOTECH
    label:
        en: "Depressurisation"
        fr: "Horspression"
    help:
        en: "Depressurise the suspension circuit for maintenance or in preparation for checking the level"
    steps:
        start:
            label:
                en: "Initialise the procedure and wait for up to 3 minutes, then disconnect the battery"
            next_step: in_progress

        in_progress:
            label:
                en: "Depressurisation in progress..."
            category: repeat
            command:
                service: [ 16, 01 ]
                repeat: 1000
            responses:
                endok: [ 70, 16, 01 ]
                endko: [ 70, 16, 00 ]

        endok:
            label:
                en: "Depressurisation is complete. Now disconnect the battery"
            next_step: finish

        endko:
            label:
                en: "The operation could not be completed"
            next_step: finish
            


Start by getting ACTZONES for all ACTTEST applicable to this ECU

Example on data needing to be entered for DEPRESSURISE_SUSPENSIONECOTECH / K LINE

Should flag somewhere that this is (1) custom and (2) a procedure / routine



